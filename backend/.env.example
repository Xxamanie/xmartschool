# SmartSchool backend environment — copy to .env and fill in real values
NODE_ENV=development
PORT=4000

# Database (Supabase Postgres or any Postgres connection string)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Frontend / CORS (comma-separated if multiple origins)
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGIN=https://your-frontend-domain.com

# Session signing: at least 32 characters locally, at least 64 random characters in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-your-cryptographically-random-64-character-secret

# Supabase server-side (service role key — keep secret, never expose to browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI integration (optional — leave blank to disable AI features)
GEMINI_API_KEY=

# Whereby API Key (optional - for live class video provider, falls back to Jitsi if unset)
WHEREBY_API_KEY=

# Email notifications (optional). SMTP_HOST and SMTP_FROM enable delivery.
# Port 465 uses TLS immediately; port 587 uses the provider's STARTTLS support.
# Leave SMTP_HOST blank to keep in-app notifications without sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Online payments — Paystack (optional). Get the SECRET key from the Paystack
# dashboard (Settings → API Keys). Use sk_test_... while testing, sk_live_... in
# production. Leave blank to disable the "Pay online" feature.
PAYSTACK_SECRET_KEY=

# Parent messaging — Termii SMS/WhatsApp (optional). API key from termii.com.
# TERMII_SENDER_ID is the registered alphanumeric sender for SMS (e.g. XmartSch).
# Leave blank to disable SMS/WhatsApp (fee reminders + results alerts become no-ops).
TERMII_API_KEY=
TERMII_SENDER_ID=

# Local password-free demo fallback — set to "true" only for local previews.
# Seeded pitch accounts use their stored Password1 bcrypt hash and do not need
# this fallback. MUST be "false" or unset in production.
ENABLE_DEMO_AUTH=false
