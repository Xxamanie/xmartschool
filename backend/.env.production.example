# Production Backend Environment Variables
# Copy this file to .env.production and fill in actual values
# Store production values in Render dashboard environment variables (or your host's secret manager)
# NEVER commit real values for any of these — this file should only ever contain placeholders.

# Database connection string (Render/Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Server port
PORT=4000

# Node environment
NODE_ENV=production

# Frontend origin (update to your deployed frontend URL)
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGIN=https://your-frontend-domain.com

# Session signing — must be at least 32 random characters. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret-minimum-32-chars

# Supabase (server) credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini API Key (optional - for AI features)
GEMINI_API_KEY=

# Whereby API Key (optional - for live class video provider, falls back to Jitsi if unset)
WHEREBY_API_KEY=

# Demo auth fallback — MUST be false/unset in production. Only set to "true" for
# local/demo previews where login should fall back to seeded demo accounts.
ENABLE_DEMO_AUTH=false
