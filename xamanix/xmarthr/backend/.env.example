# XmartHR backend — copy to .env and fill in real values
NODE_ENV=development
PORT=5060

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/xmarthr

# JWT signing secret — at least 32 random characters
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars

# Allowed frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:5174

# ── AI / Insights (optional) ─────────────────────────────────────────
# OpenAI-compatible key for natural-language answers in Insights. When unset,
# answers fall back to a deterministic summary; all analytics still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Notifications (optional) ─────────────────────────────────────────
# Termii SMS/WhatsApp. When unset, payslip/leave/review notices and
# announcements are silently skipped (they never block an HR action).
TERMII_API_KEY=
TERMII_SENDER_ID=XmartHR
# Channel: generic (SMS) | dnd | whatsapp
TERMII_CHANNEL=whatsapp
TERMII_BASE_URL=https://api.ng.termii.com
DEFAULT_COUNTRY_CODE=234

# ── Scheduler (in-process cron) ──────────────────────────────────────
# Daily automations run without anyone clicking. Hours are local 0-23.
SCHEDULER_ENABLED=true
REMINDER_HOUR=9    # clock-in reminders + pending-leave nudge to managers
ABSENTEE_HOUR=11   # auto-mark active employees with no record today as Absent

# ── Document storage ─────────────────────────────────────────────────
# "db" (base64 in DB, default) or "s3" (object storage; needs @aws-sdk/client-s3).
STORAGE_DRIVER=db
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=          # set for S3-compatible (MinIO, Cloudflare R2, DO Spaces)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=documents

# ── E-sign requests (public links) ───────────────────────────────────
# Frontend origin used to build signing links (/sign/:token).
PUBLIC_BASE_URL=http://localhost:5174
# Optional HTTP email provider (Resend/SendGrid-style: POST {from,to,subject,html}).
# When unset, the signing link is returned to HR to share manually.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@yourcompany.com
