# XmartHotel backend — copy to .env and fill in real values
NODE_ENV=development
PORT=5050

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/xmarthotel

# JWT signing secret — at least 32 random characters
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars

# Allowed frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173

# ── Payments (optional) ──────────────────────────────────────────────
# Paystack secret key. When unset, payment endpoints return "not configured"
# and the app falls back to pay-on-arrival. Use a test key (sk_test_...) locally.
PAYSTACK_SECRET_KEY=
# Where guests return after paying (frontend origin). Paystack redirects here
# to /payment/callback, and this is also used as the webhook-safe base URL.
PUBLIC_BASE_URL=http://localhost:5173

# ── Notifications (optional) ─────────────────────────────────────────
# Termii SMS/WhatsApp. When unset, booking confirmations and payment
# receipts are silently skipped (never block a booking or payment).
TERMII_API_KEY=
TERMII_SENDER_ID=XmartHotel
# Channel: generic | dnd | whatsapp
TERMII_CHANNEL=generic
TERMII_BASE_URL=https://api.ng.termii.com
# Used to normalise local phone numbers (e.g. 0803… → 234803…)
DEFAULT_COUNTRY_CODE=234

# ── AI / Insights (optional) ─────────────────────────────────────────
# OpenAI-compatible key for natural-language answers in Insights. When unset,
# answers fall back to a deterministic summary; all analytics still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
