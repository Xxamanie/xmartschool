# Production Frontend Environment Variables
# Copy this file to .env.production and fill in actual values

# API Base URL (Render backend)
VITE_API_BASE_URL=https://xmartschool.onrender.com/api

# Gemini API Key — NOTE: unused by the frontend (AI calls go through the backend's
# GEMINI_API_KEY). Left here only for backward compatibility; safe to leave blank.
VITE_GEMINI_API_KEY=

# Supabase Credentials (anon key — safe to expose to browser, but use YOUR project's
# values, not the ones from this template)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_STORAGE_BUCKET=files

# Explicit opt-in for local/demo auth fallback. MUST be "false" in production.
VITE_ENABLE_DEMO_AUTH=false
