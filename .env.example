# SmartSchool frontend environment — copy to .env.local for local development
NODE_ENV=development

# Backend API base URL (must be publicly reachable in production)
VITE_API_BASE_URL=http://localhost:4000/api

# Supabase browser configuration (anon key — safe to expose to browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_STORAGE_BUCKET=files

# Explicit opt-in for local demo auth fallback
VITE_ENABLE_DEMO_AUTH=false
